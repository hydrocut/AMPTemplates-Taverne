Meta.DisplayName=La Taverne - salon de jeux 3D (TeamKit)
Meta.Description=La Taverne de TeamKit : belote, coinche, echecs, dames et poker a jetons fictifs en 3D dans le navigateur, contre des bots ou entre amis, avec le compte TeamKit (Discord) ou en invite. Un seul programme Node.js 22 sert le jeu (WebSocket) et sa page sur un seul port, derriere nginx en HTTPS (taverne.teamkit.fr). Le code du jeu est PRIVE : l'Update telecharge une version prete avec un jeton de lecture, verifie son empreinte SHA-256 et ne touche jamais au dossier donnees/. Conteneur obligatoire.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-Taverne
Meta.DisplayImageSource=url:https://www.teamkit.fr/assets/brand/apple_touch_icon_512.png
Meta.EndpointURIFormat=https://taverne.teamkit.fr
Meta.ConfigManifest=taverneconfig.json
Meta.MetaConfigManifest=tavernemetaconfig.json
Meta.ConfigRoot=taverne.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Node.js 22 (binaire officiel, empreinte verifiee) et le jeu sont installes dans le dossier de l'instance par un script teste dans l'image cubecoders/ampbase:debian ; le conteneur isole le jeu du reste de la machine.
Meta.ExtraSetupStepsURI=https://github.com/hydrocut/AMPTemplates-Taverne#install-in-amp
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=ba3c0ab6-3fe8-493e-9925-d507c0d43c0e
Meta.ImportableExtensions=[]
